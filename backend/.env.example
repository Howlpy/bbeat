# Bbeat backend — copia este fichero a `.env` y rellena tus valores.
# Para self-hosting fácil: la mayoría de estos valores también
# se pueden editar desde la UI en /settings tras el primer arranque.

# ─── Servidor ───────────────────────────────────────────────────
BBEAT_HOST=0.0.0.0
BBEAT_PORT=8787
BBEAT_DEBUG=false

# ─── Rutas (absolutas o relativas a la raíz del repo) ───────────
BBEAT_DATA_DIR=../data
BBEAT_MUSIC_DIR=../data/music
BBEAT_COVERS_DIR=../data/covers
BBEAT_SECRETS_DIR=../data/secrets
BBEAT_DB_PATH=../data/library.db

# ─── Spotify Developer App (obligatorio para resolver metadata) ─
# Crea tu app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ─── Descarga ───────────────────────────────────────────────────
# Backend primario: votify | yt-dlp
BBEAT_DOWNLOAD_BACKEND=votify
# Formato preferido: ogg | mp3 | flac
BBEAT_AUDIO_FORMAT=ogg
# Calidad: auto | 96 | 160 | 320
BBEAT_AUDIO_QUALITY=auto
# Jobs simultáneos (cuidado con la RAM en hosts pequeños)
BBEAT_MAX_CONCURRENT_JOBS=1
# Si Votify falla, ¿intentar yt-dlp automáticamente?
BBEAT_FALLBACK_YTDLP=true

# ─── CORS (solo dev — en prod el backend sirve el frontend) ─────
BBEAT_CORS_ORIGINS=http://localhost:5173
