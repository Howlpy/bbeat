# Bbeat backend — copia este fichero a `.env` y rellena tus valores.
# Para self-hosting fácil: la mayoría de estos valores también
# se pueden editar desde la UI en /settings tras el primer arranque.

# ─── Servidor ───────────────────────────────────────────────────
BBEAT_HOST=0.0.0.0
BBEAT_PORT=8787
BBEAT_DEBUG=false

# ─── Rutas (absolutas o relativas a la raíz del repo) ───────────
BBEAT_DATA_DIR=../data
BBEAT_MUSIC_DIR=../data/music
BBEAT_COVERS_DIR=../data/covers
BBEAT_SECRETS_DIR=../data/secrets
BBEAT_TRANSCACHE_DIR=../data/transcache
BBEAT_DB_PATH=../data/library.db

# (No hace falta app de Spotify: la metadata se obtiene con SpotifyScraper,
#  sin credenciales.)

# ─── Descarga ───────────────────────────────────────────────────
# Formato: opus | ogg | m4a | mp3 | flac
# opus (por defecto) = copia el stream Opus de YouTube sin recodificar
# (mínimo tamaño, máxima calidad).
BBEAT_AUDIO_FORMAT=opus
# Calidad: auto copia el stream original; un bitrate (96/128/160/320) recodifica
BBEAT_AUDIO_QUALITY=auto
# Jobs simultáneos (cuidado con la RAM en hosts pequeños)
BBEAT_MAX_CONCURRENT_JOBS=1

# ─── Transcoding Subsonic (on-the-fly) ──────────────────────────
# Algunos clientes Subsonic no reproducen Opus y piden mp3/aac/ogg. Bbeat
# transcodifica con FFmpeg bajo demanda y cachea el resultado en disco.
# Procesos ffmpeg simultáneos: limita el pico de CPU en hosts pequeños.
BBEAT_TRANSCODE_CONCURRENCY=2
# Tope de la cache de transcoding en disco (MB). Al superarlo se borran los
# ficheros menos usados recientemente. 0 = sin límite.
BBEAT_TRANSCACHE_MAX_MB=1024

# ─── CORS (solo dev — en prod el backend sirve el frontend) ─────
BBEAT_CORS_ORIGINS=http://localhost:5173

# -- Generos con IA (opcional, desactivado por defecto) --
# Clasifica artistas con un LLM de tu eleccion. Ver README ("Géneros con IA").
# BBEAT_AI_PROVIDER=gemini        # openai | gemini | anthropic | ollama | none
# BBEAT_AI_API_KEY=               # gemini: gratis en https://aistudio.google.com/apikey
# BBEAT_AI_MODEL=                 # vacio = modelo por defecto del proveedor
# BBEAT_AI_BASE_URL=              # servidor compatible-OpenAI (OpenRouter, Groq, LM Studio...)
# BBEAT_AI_RPM=10                 # peticiones/minuto (las cuotas gratuitas son bajas)
# BBEAT_AI_TIMEOUT=60
# BBEAT_AI_MIN_CONFIDENCE=0.75    # por debajo, la sugerencia va a revision
# BBEAT_AI_BATCH_ARTISTS=5        # artistas pequenos por peticion
# Busqueda web como evidencia (opcional):
# BBEAT_SEARCH_PROVIDER=searxng   # searxng | none
# BBEAT_SEARXNG_URL=http://localhost:8080
# Coherencia por artista al importar (funciona sin IA):
# BBEAT_ARTIST_CONSISTENCY=true
