# Bbeat backend — copia este fichero a `.env` y rellena tus valores.
# Para self-hosting fácil: la mayoría de estos valores también
# se pueden editar desde la UI en /settings tras el primer arranque.

# ─── Servidor ───────────────────────────────────────────────────
BBEAT_HOST=0.0.0.0
BBEAT_PORT=8787
BBEAT_DEBUG=false

# ─── Rutas (absolutas o relativas a la raíz del repo) ───────────
BBEAT_DATA_DIR=../data
BBEAT_MUSIC_DIR=../data/music
BBEAT_COVERS_DIR=../data/covers
BBEAT_SECRETS_DIR=../data/secrets
BBEAT_DB_PATH=../data/library.db

# (No hace falta app de Spotify: la metadata se obtiene con SpotifyScraper,
#  sin credenciales.)

# ─── Descarga ───────────────────────────────────────────────────
# Backend primario: yt-dlp | votify
# yt-dlp (por defecto) baja de YouTube y NO requiere nada. Votify baja directo
# de Spotify (más calidad) pero requiere cookies de cuenta Premium subidas en
# /settings; si falla, cae a yt-dlp (BBEAT_FALLBACK_YTDLP=true).
BBEAT_DOWNLOAD_BACKEND=yt-dlp
# Formato: opus | ogg | m4a | mp3 | flac
# opus (por defecto) = copia el stream Opus de YouTube sin recodificar
# (mínimo tamaño, máxima calidad).
BBEAT_AUDIO_FORMAT=opus
# Calidad (solo aplica a Votify): auto | 96 | 160 | 320
BBEAT_AUDIO_QUALITY=auto
# Jobs simultáneos (cuidado con la RAM en hosts pequeños)
BBEAT_MAX_CONCURRENT_JOBS=1
# Si Votify falla, ¿intentar yt-dlp automáticamente?
BBEAT_FALLBACK_YTDLP=true

# ─── CORS (solo dev — en prod el backend sirve el frontend) ─────
BBEAT_CORS_ORIGINS=http://localhost:5173
