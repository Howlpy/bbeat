{
  "name": "bbeat-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "dev:https": "BBEAT_HTTPS=1 vite dev --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:https": "BBEAT_HTTPS=1 vite preview --host 0.0.0.0",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "build:native": "BBEAT_NATIVE=1 BBEAT_BUILD_DIR=build-native vite build",
    "sync:android": "npm run build:native && cap sync android",
    "apk": "npm run sync:android && cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/local-notifications": "^8.2.0",
    "@capawesome/capacitor-android-edge-to-edge-support": "^8.0.8",
    "@capgo/capacitor-media-session": "^8.0.24",
    "html-to-image": "^1.11.13",
    "lucide-svelte": "^1.0.1"
  }
}
